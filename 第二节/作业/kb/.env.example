# GitHub API 配置
# 获取Token: https://github.com/settings/tokens
# 权限: 只需要 public_repo (如果需要访问私有仓库，需要repo权限)
GITHUB_TOKEN=your_github_personal_access_token_here

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/kb_agent.log

# 数据存储配置
DATA_DIR=./data
RAW_DATA_DIR=${DATA_DIR}/raw
PROCESSED_DATA_DIR=${DATA_DIR}/processed
KNOWLEDGE_BASE_FILE=${DATA_DIR}/knowledge_base.json

# 采集配置
GITHUB_TRENDING_LANGUAGE=python  # 可以设置为 all, python, javascript, go, java 等
GITHUB_TRENDING_PERIOD=daily     # daily, weekly, monthly
MAX_REPOS_PER_RUN=50

# Hacker News 配置
HN_API_URL=https://hacker-news.firebaseio.com/v0
HN_TOP_STORIES_LIMIT=30

# AI 模型配置（如果需要）
AI_MODEL_PROVIDER=deepseek  # deepseek, glm, baichuan 等
AI_MODEL_API_KEY=your_ai_model_api_key_here
AI_MODEL_BASE_URL=https://api.deepseek.com

# 消息分发配置
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# 代理配置（如果需要）
HTTP_PROXY=http://proxy.example.com:8080
HTTPS_PROXY=http://proxy.example.com:8080
NO_PROXY=localhost,127.0.0.1